<UserControl x:Class="Courier.WPF.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardBorder}" Padding="16,14">
            <StackPanel>
                <WrapPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Поиск" Style="{StaticResource MutedText}" Margin="2,0,0,4"/>
                        <TextBox x:Name="SearchBox" Width="300" ToolTip="Логин, ФИО, роль"
                                 KeyDown="SearchBox_KeyDown"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,8">
                        <Button Content="Найти" Style="{StaticResource PrimaryButton}" Click="Search_Click"/>
                        <Button Content="Сбросить" Style="{StaticResource SecondaryButton}" Click="Reset_Click"/>
                    </StackPanel>
                </WrapPanel>

                <Separator Margin="0,4,0,10"/>

                <DockPanel>
                    <TextBlock x:Name="CountText" Text="Пользователей: 0" Style="{StaticResource MutedText}"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="+  Новый пользователь" Style="{StaticResource PrimaryButton}"
                                Click="New_Click"/>
                        <Button Content="Изменить" Style="{StaticResource SecondaryButton}" Click="Edit_Click"/>
                        <Button Content="Заблокировать" Style="{StaticResource DangerButton}" Click="Block_Click"/>
                        <Button Content="Печать" Style="{StaticResource SecondaryButton}" Click="Print_Click"/>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="6" Margin="0,12,0,0">
            <DataGrid x:Name="UsersGrid" MouseDoubleClick="UsersGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Логин" Binding="{Binding login}" Width="150"/>
                    <DataGridTextColumn Header="ФИО" Binding="{Binding fio}" Width="*"/>
                    <DataGridTextColumn Header="Роль" Binding="{Binding rol}" Width="160"/>
                    <DataGridTextColumn Header="Телефон" Binding="{Binding telefon}" Width="150"/>
                    <DataGridCheckBoxColumn Header="Активен" Binding="{Binding is_active}" Width="75"/>
                    <DataGridTextColumn Header="Создан"
                                        Binding="{Binding data_sozdaniya, StringFormat={}{0:dd.MM.yyyy}}"
                                        Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
