<UserControl x:Class="Courier.WPF.Views.TariffsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardBorder}" Padding="16,14">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Зона:" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <ComboBox x:Name="ZoneFilter" Width="200" DisplayMemberPath="nazvanie"
                              SelectedValuePath="id_zony" SelectionChanged="ZoneFilter_Changed"/>
                    <Button Content="Все зоны" Style="{StaticResource GhostButton}" Click="AllZones_Click"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="+  Новый тариф" Style="{StaticResource PrimaryButton}" Click="New_Click"/>
                    <Button Content="Изменить" Style="{StaticResource SecondaryButton}" Click="Edit_Click"/>
                    <Button Content="Удалить" Style="{StaticResource DangerButton}" Click="Delete_Click"/>
                    <Button Content="Печать" Style="{StaticResource SecondaryButton}" Click="Print_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardBorder}" Padding="6">
                <DataGrid x:Name="TariffsGrid" MouseDoubleClick="TariffsGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Зона" Binding="{Binding zona}" Width="*"/>
                        <DataGridTextColumn Header="Вес от, кг" Binding="{Binding ves_ot, StringFormat={}{0:N2}}"
                                            Width="110"/>
                        <DataGridTextColumn Header="Вес до, кг" Binding="{Binding ves_do, StringFormat={}{0:N2}}"
                                            Width="110"/>
                        <DataGridTextColumn Header="Стоимость" Binding="{Binding cena, StringFormat={}{0:N2} ₽}"
                                            Width="130"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Как рассчитывается стоимость" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Стоимость зависит от зоны обслуживания и веса заказа. Для каждой зоны задаются диапазоны веса и цена."
                               FontSize="12" Foreground="{StaticResource MutedBrush}" LineHeight="19"/>
                    <Separator Margin="0,14"/>
                    <TextBlock Text="Пример" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Text="Центр · 0–1 кг = 300 ₽&#10;Центр · 1,01–5 кг = 450 ₽&#10;Центр · 5,01–20 кг = 700 ₽"
                               FontSize="12" Foreground="{StaticResource MutedBrush}" LineHeight="21"/>
                    <Separator Margin="0,14"/>
                    <Border Background="{StaticResource PrimaryLightBrush}" CornerRadius="8" Padding="12">
                        <TextBlock Text="При создании заказа тариф подбирается автоматически и фиксируется в заказе. Изменение тарифа не меняет стоимость уже созданных заказов."
                                   FontSize="11.5" Foreground="{StaticResource PrimaryDarkBrush}" LineHeight="18"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
