<UserControl x:Class="Courier.WPF.Views.AuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardBorder}" Padding="16,14">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Поиск:" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBox x:Name="SearchBox" Width="320" ToolTip="Логин, действие, таблица"
                             KeyDown="SearchBox_KeyDown"/>
                    <Button Content="Найти" Style="{StaticResource PrimaryButton}" Click="Search_Click"/>
                    <Button Content="Обновить" Style="{StaticResource SecondaryButton}" Click="Refresh_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="CountText" Text="Записей: 0" Style="{StaticResource MutedText}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button Content="Печать" Style="{StaticResource SecondaryButton}" Click="Print_Click"/>
                    <Button Content="CSV" Style="{StaticResource SecondaryButton}" Click="Export_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="6" Margin="0,12,0,0">
            <DataGrid x:Name="AuditGrid">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Дата и время"
                                        Binding="{Binding data_deystviya, StringFormat={}{0:dd.MM.yyyy HH:mm:ss}}"
                                        Width="150"/>
                    <DataGridTextColumn Header="Пользователь" Binding="{Binding login}" Width="140"/>
                    <DataGridTextColumn Header="Действие" Binding="{Binding deystvie}" Width="*"/>
                    <DataGridTextColumn Header="Таблица" Binding="{Binding tablica}" Width="180"/>
                    <DataGridTextColumn Header="Объект" Binding="{Binding id_obekta}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
