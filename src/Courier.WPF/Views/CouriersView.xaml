<UserControl x:Class="Courier.WPF.Views.CouriersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardBorder}" Padding="16,14">
            <StackPanel>
                <WrapPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Поиск" Style="{StaticResource MutedText}" Margin="2,0,0,4"/>
                        <TextBox x:Name="SearchBox" Width="300" ToolTip="ФИО, телефон, транспорт"
                                 KeyDown="SearchBox_KeyDown"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,8">
                        <Button Content="Найти" Style="{StaticResource PrimaryButton}" Click="Search_Click"/>
                        <Button Content="Сбросить" Style="{StaticResource SecondaryButton}" Click="Reset_Click"/>
                    </StackPanel>
                </WrapPanel>

                <Separator Margin="0,4,0,10"/>

                <DockPanel>
                    <TextBlock x:Name="CountText" Text="Курьеров: 0" Style="{StaticResource MutedText}"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="+  Новый курьер" Style="{StaticResource PrimaryButton}"
                                Click="New_Click"/>
                        <Button Content="Изменить" Style="{StaticResource SecondaryButton}" Click="Edit_Click"/>
                        <Button Content="В архив" Style="{StaticResource DangerButton}" Click="Archive_Click"/>
                        <Button Content="Печать" Style="{StaticResource SecondaryButton}" Click="Print_Click"/>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="6" Margin="0,12,0,0">
            <DataGrid x:Name="CouriersGrid" MouseDoubleClick="CouriersGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ФИО" Binding="{Binding fio}" Width="*"/>
                    <DataGridTextColumn Header="Телефон" Binding="{Binding telefon}" Width="150"/>
                    <DataGridTextColumn Header="Транспорт" Binding="{Binding transport}" Width="105"/>
                    <DataGridTextColumn Header="Зона" Binding="{Binding zona}" Width="125"/>
                    <DataGridTextColumn Header="Статус" Binding="{Binding status}" Width="95"/>
                    <DataGridCheckBoxColumn Header="Активен" Binding="{Binding is_active}" Width="75"/>
                    <DataGridTextColumn Header="Всего" Binding="{Binding vsego_zakazov}" Width="65"/>
                    <DataGridTextColumn Header="Доставлено" Binding="{Binding dostavleno}" Width="90"/>
                    <DataGridTextColumn Header="Сумма" Binding="{Binding summa_dostavki, StringFormat={}{0:N2} ₽}"
                                        Width="105"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
