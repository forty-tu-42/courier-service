<UserControl x:Class="Courier.WPF.Views.OrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель фильтров и действий -->
        <Border Style="{StaticResource CardBorder}" Padding="16,14">
            <StackPanel>
                <WrapPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Поиск" Style="{StaticResource MutedText}" Margin="2,0,0,4"/>
                        <TextBox x:Name="SearchBox" Width="260" ToolTip="Номер заказа, клиент, телефон, получатель"
                                 KeyDown="SearchBox_KeyDown"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Статус" Style="{StaticResource MutedText}" Margin="2,0,0,4"/>
                        <ComboBox x:Name="StatusFilter" Width="170" DisplayMemberPath="nazvanie"
                                  SelectedValuePath="id_statusa"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Дата с" Style="{StaticResource MutedText}" Margin="2,0,0,4"/>
                        <DatePicker x:Name="DateFrom" Width="140"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Дата по" Style="{StaticResource MutedText}" Margin="2,0,0,4"/>
                        <DatePicker x:Name="DateTo" Width="140"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,8">
                        <Button Content="Найти" Style="{StaticResource PrimaryButton}" Click="Search_Click"/>
                        <Button Content="Сбросить" Style="{StaticResource SecondaryButton}" Click="Reset_Click"/>
                    </StackPanel>
                </WrapPanel>

                <Separator Margin="0,4,0,10"/>

                <DockPanel>
                    <TextBlock x:Name="CountText" Text="Заказов: 0" Style="{StaticResource MutedText}"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="NewButton" Content="+  Новый заказ" Style="{StaticResource PrimaryButton}"
                                Click="New_Click"/>
                        <Button x:Name="EditButton" Content="Изменить" Style="{StaticResource SecondaryButton}"
                                Click="Edit_Click"/>
                        <Button x:Name="AssignButton" Content="Назначить курьера" Style="{StaticResource SecondaryButton}"
                                Click="Assign_Click"/>
                        <Button x:Name="StatusButton" Content="Сменить статус" Style="{StaticResource SecondaryButton}"
                                Click="Status_Click"/>
                        <Button x:Name="CancelButton" Content="Отменить" Style="{StaticResource DangerButton}"
                                Click="Cancel_Click"/>
                        <Button Content="Печать" Style="{StaticResource SecondaryButton}" Click="Print_Click"/>
                        <Button Content="CSV" Style="{StaticResource SecondaryButton}" Click="Export_Click"/>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Таблица и карточка -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="6">
                <DataGrid x:Name="OrdersGrid" SelectionChanged="OrdersGrid_SelectionChanged"
                          MouseDoubleClick="OrdersGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Номер" Binding="{Binding nomer}" Width="140"/>
                        <DataGridTextColumn Header="Клиент" Binding="{Binding klient}" Width="*"
                                            MinWidth="170"/>
                        <DataGridTextColumn Header="Зона" Binding="{Binding zona}" Width="85"/>
                        <DataGridTextColumn Header="Сумма" Binding="{Binding cena, StringFormat={}{0:N2} ₽}"
                                            Width="85"/>
                        <DataGridTextColumn Header="Статус" Binding="{Binding status}" Width="95"/>
                        <DataGridTextColumn Header="Курьер" Binding="{Binding kurier}" Width="115"/>
                        <DataGridTextColumn Header="Создан" Binding="{Binding data_sozdaniya, StringFormat={}{0:dd.MM.yyyy}}"
                                            Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Карточка заказа" Style="{StaticResource SectionTitle}"/>
                        <TextBlock x:Name="DetailNumber" Text="Выберите заказ" FontSize="18"
                                   FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                        <TextBlock x:Name="DetailStatus" Text="" Style="{StaticResource MutedText}"
                                   Margin="0,2,0,12"/>

                        <TextBlock Text="Клиент" Style="{StaticResource MutedText}"/>
                        <TextBlock x:Name="DetailClient" FontWeight="SemiBold" Margin="0,1,0,0"/>
                        <TextBlock x:Name="DetailClientPhone" Style="{StaticResource MutedText}"/>

                        <Separator Margin="0,12"/>

                        <TextBlock Text="Отправитель" Style="{StaticResource MutedText}"/>
                        <TextBlock x:Name="DetailSender" Margin="0,1,0,8"/>

                        <TextBlock Text="Получатель" Style="{StaticResource MutedText}"/>
                        <TextBlock x:Name="DetailRecipient" FontWeight="SemiBold" Margin="0,1,0,0"/>
                        <TextBlock x:Name="DetailRecipientPhone" Style="{StaticResource MutedText}"/>
                        <TextBlock x:Name="DetailRecipientAddress" Margin="0,1,0,8"/>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Зона" Style="{StaticResource MutedText}"/>
                                <TextBlock x:Name="DetailZone" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Вес" Style="{StaticResource MutedText}"/>
                                <TextBlock x:Name="DetailWeight" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Стоимость" Style="{StaticResource MutedText}"/>
                                <TextBlock x:Name="DetailPrice" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}" FontSize="16"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Оплата" Style="{StaticResource MutedText}"/>
                                <TextBlock x:Name="DetailPayment" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Курьер" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                        <TextBlock x:Name="DetailCourier" FontWeight="SemiBold"/>

                        <TextBlock Text="Комментарий" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                        <TextBlock x:Name="DetailComment" FontSize="12"/>

                        <Separator Margin="0,14"/>

                        <TextBlock Text="История статусов" Style="{StaticResource SectionTitle}"/>
                        <ItemsControl x:Name="HistoryList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                                            Padding="0,7">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock Text="{Binding status}" FontWeight="SemiBold"
                                                           FontSize="12"/>
                                                <TextBlock Text="{Binding data_izmeneniya, StringFormat={}{0:dd.MM.yyyy HH:mm}}"
                                                           Style="{StaticResource MutedText}" HorizontalAlignment="Right"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding polzovatel}" Style="{StaticResource MutedText}"/>
                                            <TextBlock Text="{Binding kommentariy}" FontSize="11.5" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
