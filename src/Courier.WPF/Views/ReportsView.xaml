<UserControl x:Class="Courier.WPF.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardBorder}" Padding="16,14">
            <WrapPanel>
                <StackPanel Margin="0,0,12,8">
                    <TextBlock Text="Период с" Style="{StaticResource MutedText}" Margin="2,0,0,4"/>
                    <DatePicker x:Name="DateFrom" Width="150"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,8">
                    <TextBlock Text="Период по" Style="{StaticResource MutedText}" Margin="2,0,0,4"/>
                    <DatePicker x:Name="DateTo" Width="150"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,8">
                    <TextBlock Text="Отчёт" Style="{StaticResource MutedText}" Margin="2,0,0,4"/>
                    <ComboBox x:Name="ReportTypeBox" Width="280" Height="36">
                        <ComboBoxItem Content="Доставки за период" Tag="deliveries" IsSelected="True"/>
                        <ComboBoxItem Content="Заказы по статусам" Tag="statuses"/>
                        <ComboBoxItem Content="Загрузка курьеров" Tag="couriers"/>
                        <ComboBoxItem Content="Выручка по зонам" Tag="zones"/>
                        <ComboBoxItem Content="Выручка по месяцам" Tag="months"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,8">
                    <Button Content="Сформировать" Style="{StaticResource PrimaryButton}" Click="Build_Click"/>
                    <Button Content="Печать" Style="{StaticResource SecondaryButton}" Click="Print_Click"/>
                    <Button Content="CSV" Style="{StaticResource SecondaryButton}" Click="Export_Click"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="16,12" Margin="0,12,0,0">
            <DockPanel>
                <StackPanel>
                    <TextBlock x:Name="ReportTitle" Text="Доставки за период" FontWeight="SemiBold"
                               FontSize="14"/>
                    <TextBlock x:Name="ReportSubtitle" Text="" Style="{StaticResource MutedText}"
                               Margin="0,2,0,0"/>
                </StackPanel>
                <TextBlock x:Name="SummaryText" HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="6" Margin="0,12,0,0">
            <DataGrid x:Name="ReportGrid">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Номер" Binding="{Binding nomer}" Width="150"/>
                    <DataGridTextColumn Header="Клиент" Binding="{Binding klient}" Width="*"/>
                    <DataGridTextColumn Header="Курьер" Binding="{Binding kurier}" Width="180"/>
                    <DataGridTextColumn Header="Зона" Binding="{Binding zona}" Width="120"/>
                    <DataGridTextColumn Header="Вес" Binding="{Binding ves, StringFormat={}{0:N2}}" Width="80"/>
                    <DataGridTextColumn Header="Сумма" Binding="{Binding cena, StringFormat={}{0:N2} ₽}"
                                        Width="110"/>
                    <DataGridTextColumn Header="Оплата" Binding="{Binding sposob_oplaty}" Width="100"/>
                    <DataGridTextColumn Header="Доставлен"
                                        Binding="{Binding data_dostavki, StringFormat={}{0:dd.MM.yyyy HH:mm}}"
                                        Width="145"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
