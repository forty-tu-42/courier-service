<Window x:Class="Courier.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ИС «Курьерская служба»"
        Height="860" Width="1420"
        MinHeight="700" MinWidth="1180"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryDarkBrush}">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="10" Background="#26FFFFFF">
                        <TextBlock Text="КС" Foreground="White" FontWeight="Bold" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="КУРЬЕРСКАЯ СЛУЖБА" Foreground="White" FontWeight="Bold"
                                   FontSize="14"/>
                        <TextBlock Text="Информационно-справочная система" Foreground="#99FFFFFF"
                                   FontSize="10.5"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock x:Name="UserText" Foreground="White" FontWeight="SemiBold"
                                   FontSize="12.5" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="RoleText" Foreground="#99FFFFFF" FontSize="10.5"
                                   HorizontalAlignment="Right"/>
                    </StackPanel>
                    <Border Width="38" Height="38" CornerRadius="19" Background="{StaticResource AccentBrush}">
                        <TextBlock x:Name="AvatarText" Text="А" Foreground="White" FontWeight="Bold"
                                   FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Button Content="Выйти" Style="{StaticResource NavButton}" Height="34"
                            Margin="14,0,0,0" Foreground="#CBD5E1" Click="Logout_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Основная область -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="228"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Боковое меню -->
            <Border Grid.Column="0" Background="#0B2E2E">
                <DockPanel Margin="0,12,0,12">
                    <StackPanel DockPanel.Dock="Bottom">
                        <Separator Background="#1E4A4A" Margin="18,10"/>
                        <Button Content="О программе" Tag="about" Style="{StaticResource NavButton}"
                                Click="Menu_Click"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="РАБОЧЕЕ ПРОСТРАНСТВО" Foreground="#5F8F8F" FontSize="9.5"
                                   FontWeight="SemiBold" Margin="22,6,0,8"/>
                        <Button x:Name="NavDashboard" Content="Панель управления" Tag="dashboard"
                                Style="{StaticResource NavButton}" Click="Menu_Click"/>
                        <Button x:Name="NavOrders" Content="Заказы" Tag="orders"
                                Style="{StaticResource NavButton}" Click="Menu_Click"/>
                        <Button x:Name="NavCouriers" Content="Курьеры" Tag="couriers"
                                Style="{StaticResource NavButton}" Click="Menu_Click"/>
                        <Button x:Name="NavClients" Content="Клиенты" Tag="clients"
                                Style="{StaticResource NavButton}" Click="Menu_Click"/>

                        <TextBlock x:Name="SectionReferences" Text="СПРАВОЧНИКИ И АНАЛИТИКА"
                                   Foreground="#5F8F8F" FontSize="9.5"
                                   FontWeight="SemiBold" Margin="22,18,0,8"/>
                        <Button x:Name="NavTariffs" Content="Тарифы и зоны" Tag="tariffs"
                                Style="{StaticResource NavButton}" Click="Menu_Click"/>
                        <Button x:Name="NavReports" Content="Отчёты" Tag="reports"
                                Style="{StaticResource NavButton}" Click="Menu_Click"/>

                        <TextBlock x:Name="SectionAdmin" Text="АДМИНИСТРИРОВАНИЕ"
                                   Foreground="#5F8F8F" FontSize="9.5"
                                   FontWeight="SemiBold" Margin="22,18,0,8"/>
                        <Button x:Name="NavUsers" Content="Пользователи" Tag="users"
                                Style="{StaticResource NavButton}" Click="Menu_Click"/>
                        <Button x:Name="NavAudit" Content="Журнал аудита" Tag="audit"
                                Style="{StaticResource NavButton}" Click="Menu_Click"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Контент -->
            <Grid Grid.Column="1" Margin="22,16,22,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="PageTitleText" Text="Панель управления"
                               Style="{StaticResource PageTitle}"/>
                    <TextBlock x:Name="PageSubtitleText" Style="{StaticResource MutedText}"
                               Margin="14,9,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <ContentControl x:Name="PageHost" Grid.Row="1" Margin="0,14,0,0"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"/>
            </Grid>
        </Grid>

    </Grid>
</Window>
