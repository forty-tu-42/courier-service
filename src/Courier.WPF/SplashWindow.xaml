<Window x:Class="Courier.WPF.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Загрузка"
        Width="540" Height="320"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize">
    <Border CornerRadius="18" Background="{StaticResource PrimaryDarkBrush}" Padding="34">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.35"/>
        </Border.Effect>
        <StackPanel VerticalAlignment="Center">
            <Border Width="64" Height="64" CornerRadius="16" Background="#26FFFFFF"
                    HorizontalAlignment="Left">
                <TextBlock Text="КС" Foreground="White" FontSize="23" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="КУРЬЕРСКАЯ СЛУЖБА" Foreground="White" FontSize="23"
                       FontWeight="Bold" Margin="0,18,0,0"/>
            <TextBlock Text="Информационно-справочная система" Foreground="#B3FFFFFF"
                       FontSize="12" Margin="0,4,0,0"/>
            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,26,0,0"
                         Background="#1AFFFFFF" Foreground="#5EEAD4" BorderThickness="0"/>
            <TextBlock Text="Загрузка приложения…" Foreground="#99FFFFFF" FontSize="10.5"
                       Margin="0,8,0,0"/>
        </StackPanel>
    </Border>
</Window>
