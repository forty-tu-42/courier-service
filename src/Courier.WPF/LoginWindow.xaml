<Window x:Class="Courier.WPF.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход — ИС «Курьерская служба»"
        Height="620" Width="1000"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="White">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="46*"/>
            <ColumnDefinition Width="54*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая брендовая панель -->
        <Border Grid.Column="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0F766E" Offset="0"/>
                    <GradientStop Color="#115E59" Offset="0.55"/>
                    <GradientStop Color="#0B3B3B" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="44,48">
                <StackPanel VerticalAlignment="Center">
                    <Border Width="72" Height="72" CornerRadius="18" Background="#26FFFFFF"
                            HorizontalAlignment="Left">
                        <TextBlock Text="КС" Foreground="White" FontSize="26" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="КУРЬЕРСКАЯ&#10;СЛУЖБА" Foreground="White" FontSize="34"
                               FontWeight="Bold" Margin="0,28,0,0" LineHeight="40"/>
                    <TextBlock Text="Информационно-справочная система учёта заказов, курьеров и доставок"
                               Foreground="#CCFFFFFF" FontSize="14" Margin="0,14,0,0"
                               MaxWidth="360" HorizontalAlignment="Left" LineHeight="22"/>

                    <StackPanel Margin="0,42,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Width="8" Height="8" CornerRadius="4" Background="#5EEAD4"
                                    VerticalAlignment="Center"/>
                            <TextBlock Text="Учёт заказов и клиентов" Foreground="#E6FFFFFF"
                                       Margin="12,0,0,0" FontSize="13"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Width="8" Height="8" CornerRadius="4" Background="#5EEAD4"
                                    VerticalAlignment="Center"/>
                            <TextBlock Text="Назначение курьеров и статусы" Foreground="#E6FFFFFF"
                                       Margin="12,0,0,0" FontSize="13"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Width="8" Height="8" CornerRadius="4" Background="#5EEAD4"
                                    VerticalAlignment="Center"/>
                            <TextBlock Text="Отчёты и REST API" Foreground="#E6FFFFFF"
                                       Margin="12,0,0,0" FontSize="13"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="Ярославский градостроительный колледж · 2026"
                           Foreground="#80FFFFFF" FontSize="11" VerticalAlignment="Bottom"/>
            </Grid>
        </Border>

        <!-- Правая панель входа -->
        <Border Grid.Column="1" Background="White">
            <Grid Margin="64,56">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Вход в систему" FontSize="28" FontWeight="Bold"/>
                    <TextBlock Text="Введите логин и пароль, выданные администратором"
                               Style="{StaticResource MutedText}" Margin="0,8,0,30"/>

                    <TextBlock Text="Логин" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                    <TextBox x:Name="LoginBox" Height="42" FontSize="14" TabIndex="0"/>

                    <TextBlock Text="Пароль" FontWeight="SemiBold" FontSize="12" Margin="0,18,0,6"/>
                    <PasswordBox x:Name="PasswordBox" Height="42" FontSize="14" TabIndex="1"/>

                    <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}"
                               FontSize="12" Margin="0,14,0,0" Visibility="Collapsed"
                               TextWrapping="Wrap"/>

                    <Button x:Name="LoginButton" Content="Войти" Height="44" Margin="0,22,0,0"
                            Style="{StaticResource PrimaryButton}" FontSize="14"
                            IsDefault="True" Click="Login_Click"/>

                    <Border Background="#F8FAFC" CornerRadius="10" Padding="16" Margin="0,26,0,0"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Тестовые учётные записи" FontWeight="SemiBold" FontSize="12"
                                       Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="admin / admin123" FontFamily="Consolas" FontSize="12"/>
                                    <TextBlock Text="manager / manager123" FontFamily="Consolas" FontSize="12"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="courier / courier123" FontFamily="Consolas" FontSize="12"/>
                                    <TextBlock Text="Полный доступ — admin" Style="{StaticResource MutedText}"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <Button Content="Выход" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Click="Exit_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
