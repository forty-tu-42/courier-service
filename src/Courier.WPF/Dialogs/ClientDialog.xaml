<Window x:Class="Courier.WPF.Dialogs.ClientDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Клиент" Height="560" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource PrimaryDarkBrush}" Padding="24,18">
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="Новый клиент" Foreground="White"
                           FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="Контактные данные заказчика" Foreground="#B3FFFFFF" FontSize="11.5"
                           Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Padding="24,18" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="ФИО *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                <TextBox x:Name="FioBox" Height="40"/>

                <TextBlock Text="Телефон *" FontWeight="SemiBold" FontSize="12" Margin="0,14,0,6"/>
                <TextBox x:Name="PhoneBox" Height="40"/>

                <TextBlock Text="E-mail" FontWeight="SemiBold" FontSize="12" Margin="0,14,0,6"/>
                <TextBox x:Name="EmailBox" Height="40"/>

                <TextBlock Text="Адрес" FontWeight="SemiBold" FontSize="12" Margin="0,14,0,6"/>
                <TextBox x:Name="AddressBox" Height="40"/>

                <CheckBox x:Name="ActiveBox" Content="Клиент активен" IsChecked="True" Margin="0,18,0,0"/>

                <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" FontSize="12"
                           Margin="0,12,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="24,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" Style="{StaticResource SecondaryButton}" Width="110" IsCancel="True"/>
                <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" Width="140"
                        IsDefault="True" Click="Save_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
