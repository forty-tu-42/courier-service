<Window x:Class="Courier.WPF.Dialogs.StatusDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Статус заказа" Height="420" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource PrimaryDarkBrush}" Padding="24,18">
            <StackPanel>
                <TextBlock Text="Изменение статуса" Foreground="White" FontSize="20" FontWeight="Bold"/>
                <TextBlock x:Name="OrderText" Text="" Foreground="#B3FFFFFF" FontSize="11.5"
                           Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="24,18">
            <TextBlock Text="Новый статус *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
            <ComboBox x:Name="StatusBox" DisplayMemberPath="nazvanie" SelectedValuePath="id_statusa"
                      Height="40"/>

            <TextBlock Text="Комментарий" FontWeight="SemiBold" FontSize="12" Margin="0,16,0,6"/>
            <TextBox x:Name="CommentBox" Height="80" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalContentAlignment="Top" Padding="10,8"/>

            <Border Background="#FFF7ED" CornerRadius="8" Padding="12" Margin="0,14,0,0">
                <TextBlock Text="При статусе «Доставлен» фиксируется дата доставки и курьер освобождается. При отмене курьер также освобождается."
                           FontSize="11.5" Foreground="#9A3412"/>
            </Border>
        </StackPanel>

        <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="24,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" Style="{StaticResource SecondaryButton}" Width="110" IsCancel="True"/>
                <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" Width="140"
                        IsDefault="True" Click="Save_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
