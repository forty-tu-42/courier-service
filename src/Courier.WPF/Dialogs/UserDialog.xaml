<Window x:Class="Courier.WPF.Dialogs.UserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Пользователь" Height="660" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource PrimaryDarkBrush}" Padding="24,18">
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="Новый пользователь" Foreground="White"
                           FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="Учётная запись и права доступа" Foreground="#B3FFFFFF" FontSize="11.5"
                           Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Padding="24,18" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Логин *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                <TextBox x:Name="LoginBox" Height="40"/>

                <TextBlock x:Name="PasswordLabel" Text="Пароль *" FontWeight="SemiBold" FontSize="12"
                           Margin="0,14,0,6"/>
                <PasswordBox x:Name="PasswordBox" Height="40"/>
                <TextBlock x:Name="PasswordHint" Text="Не менее 6 символов" Style="{StaticResource MutedText}"
                           Margin="2,4,0,0"/>

                <TextBlock Text="ФИО *" FontWeight="SemiBold" FontSize="12" Margin="0,14,0,6"/>
                <TextBox x:Name="FioBox" Height="40"/>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Роль *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                        <ComboBox x:Name="RoleBox" DisplayMemberPath="nazvanie" SelectedValuePath="id_roli"
                                  Height="40"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Телефон" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                        <TextBox x:Name="PhoneBox" Height="40"/>
                    </StackPanel>
                </Grid>

                <CheckBox x:Name="ActiveBox" Content="Учётная запись активна" IsChecked="True" Margin="0,18,0,0"/>

                <Border Background="#EFF6FF" CornerRadius="8" Padding="12" Margin="0,16,0,0">
                    <TextBlock Text="Администратор управляет пользователями и справочниками. Менеджер работает с заказами, клиентами и отчётами. Курьер видит только свои заказы."
                               FontSize="11.5" Foreground="#1E40AF" LineHeight="18"/>
                </Border>

                <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" FontSize="12"
                           Margin="0,12,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="24,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" Style="{StaticResource SecondaryButton}" Width="110" IsCancel="True"/>
                <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" Width="140"
                        IsDefault="True" Click="Save_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
