<Window x:Class="Courier.WPF.Dialogs.OrderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заказ" Height="830" Width="800"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource PrimaryDarkBrush}" Padding="24,18">
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="Новый заказ" Foreground="White"
                           FontSize="21" FontWeight="Bold"/>
                <TextBlock Text="Заполните данные отправителя, получателя и параметры доставки"
                           Foreground="#B3FFFFFF" FontSize="11.5" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,18">
            <StackPanel>
                <TextBlock Text="КЛИЕНТ" Style="{StaticResource MutedText}" FontWeight="SemiBold"
                           Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="ClientBox" DisplayMemberPath="fio" SelectedValuePath="id_klienta"
                              Height="40"/>
                    <Button Grid.Column="1" Content="+ Новый клиент" Style="{StaticResource SecondaryButton}"
                            Height="40" Margin="8,0,0,0" Click="NewClient_Click"/>
                </Grid>

                <TextBlock Text="Адрес отправителя *" FontWeight="SemiBold" FontSize="12" Margin="0,16,0,6"/>
                <TextBox x:Name="SenderBox" Height="40"/>

                <Separator Margin="0,18"/>

                <TextBlock Text="ПОЛУЧАТЕЛЬ" Style="{StaticResource MutedText}" FontWeight="SemiBold"
                           Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="ФИО *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                        <TextBox x:Name="RecipientFioBox" Height="40"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Телефон *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                        <TextBox x:Name="RecipientPhoneBox" Height="40"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="Адрес доставки *" FontWeight="SemiBold" FontSize="12" Margin="0,14,0,6"/>
                <TextBox x:Name="RecipientAddressBox" Height="40"/>

                <Separator Margin="0,18"/>

                <TextBlock Text="ПАРАМЕТРЫ ДОСТАВКИ" Style="{StaticResource MutedText}" FontWeight="SemiBold"
                           Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Вес, кг *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                        <TextBox x:Name="WeightBox" Height="40" TextChanged="WeightOrZone_Changed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Зона обслуживания *" FontWeight="SemiBold" FontSize="12"
                                   Margin="0,0,0,6"/>
                        <ComboBox x:Name="ZoneBox" DisplayMemberPath="nazvanie" SelectedValuePath="id_zony"
                                  Height="40" SelectionChanged="WeightOrZone_Changed"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Способ оплаты" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                        <ComboBox x:Name="PaymentBox" Height="40">
                            <ComboBoxItem Content="Наличные"/>
                            <ComboBoxItem Content="Карта"/>
                            <ComboBoxItem Content="Онлайн"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Курьер (необязательно)" FontWeight="SemiBold" FontSize="12"
                                   Margin="0,0,0,6"/>
                        <ComboBox x:Name="CourierBox" DisplayMemberPath="fio" SelectedValuePath="id_kuriera"
                                  Height="40"/>
                    </StackPanel>
                </Grid>

                <Border Background="{StaticResource PrimaryLightBrush}" CornerRadius="10" Padding="14"
                        Margin="0,16,0,0">
                    <DockPanel>
                        <TextBlock Text="Стоимость доставки" Foreground="{StaticResource PrimaryDarkBrush}"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PriceText" Text="—" HorizontalAlignment="Right"
                                   FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}"/>
                    </DockPanel>
                </Border>

                <TextBlock Text="Комментарий" FontWeight="SemiBold" FontSize="12" Margin="0,16,0,6"/>
                <TextBox x:Name="CommentBox" Height="70" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalContentAlignment="Top" Padding="10,8"/>

                <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" FontSize="12"
                           Margin="0,12,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="24,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" Style="{StaticResource SecondaryButton}" Width="110"
                        IsCancel="True"/>
                <Button x:Name="SaveButton" Content="Сохранить" Style="{StaticResource PrimaryButton}"
                        Width="140" IsDefault="True" Click="Save_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
