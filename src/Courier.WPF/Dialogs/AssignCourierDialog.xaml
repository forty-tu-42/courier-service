<Window x:Class="Courier.WPF.Dialogs.AssignCourierDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Назначение курьера" Height="560" Width="700"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource PrimaryDarkBrush}" Padding="24,18">
            <StackPanel>
                <TextBlock Text="Назначение курьера" Foreground="White" FontSize="20" FontWeight="Bold"/>
                <TextBlock x:Name="OrderText" Text="" Foreground="#B3FFFFFF" FontSize="11.5"
                           Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="#F8FAFC" Padding="24,12">
            <TextBlock x:Name="HintText" Style="{StaticResource MutedText}"/>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="24,14" Padding="6">
            <DataGrid x:Name="CourierGrid" SelectionChanged="CourierGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Курьер" Binding="{Binding fio}" Width="*"/>
                    <DataGridTextColumn Header="Телефон" Binding="{Binding telefon}" Width="150"/>
                    <DataGridTextColumn Header="Транспорт" Binding="{Binding transport}" Width="110"/>
                    <DataGridTextColumn Header="Зона" Binding="{Binding zona}" Width="130"/>
                    <DataGridTextColumn Header="Статус" Binding="{Binding status}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="24,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" Style="{StaticResource SecondaryButton}" Width="110" IsCancel="True"/>
                <Button x:Name="AssignButton" Content="Назначить" Style="{StaticResource PrimaryButton}"
                        Width="150" IsEnabled="False" Click="Assign_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
