<Window x:Class="Courier.WPF.Dialogs.TariffDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Тариф" Height="480" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource PrimaryDarkBrush}" Padding="24,18">
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="Новый тариф" Foreground="White"
                           FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="Диапазон веса и стоимость доставки" Foreground="#B3FFFFFF"
                           FontSize="11.5" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="24,18">
            <TextBlock Text="Зона обслуживания *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
            <ComboBox x:Name="ZoneBox" DisplayMemberPath="nazvanie" SelectedValuePath="id_zony" Height="40"/>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Вес от, кг *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                    <TextBox x:Name="FromBox" Height="40"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Вес до, кг *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                    <TextBox x:Name="ToBox" Height="40"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="Стоимость, ₽ *" FontWeight="SemiBold" FontSize="12" Margin="0,14,0,6"/>
            <TextBox x:Name="PriceBox" Height="40"/>

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" FontSize="12"
                       Margin="0,12,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="24,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" Style="{StaticResource SecondaryButton}" Width="110" IsCancel="True"/>
                <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" Width="140"
                        IsDefault="True" Click="Save_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
